---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  coverImage?: string | ImageMetadata;
  alt?: string;
  title: string;
}

const { coverImage, alt, title } = Astro.props;
const imageAlt = alt || `Cover image for ${title}`;
const isFlickrUrl =
  typeof coverImage === 'string' && coverImage.startsWith('https://live.staticflickr.com/');
---

{
  coverImage && (
    <figure class="my-6">
      {typeof coverImage === 'string' ? (
        isFlickrUrl ? (
          <Image
            src={coverImage}
            inferSize
            alt={imageAlt}
            loading="eager"
            fetchpriority="high"
            decoding="async"
            class="h-auto w-full rounded-lg shadow-lg"
          />
        ) : (
          <img
            src={coverImage}
            alt={imageAlt}
            loading="eager"
            decoding="async"
            class="h-auto w-full rounded-lg shadow-lg"
          />
        )
      ) : (
        <Image
          src={coverImage}
          alt={imageAlt}
          loading="eager"
          fetchpriority="high"
          decoding="async"
          class="h-auto w-full rounded-lg shadow-lg"
        />
      )}
    </figure>
  )
}
