---
import Layout from '@layouts/Layout.astro';
import Container from '@components/Container.astro';
import BackToPrevious from '@components/BackToPrevious.astro';
import { HIGHLIGHTS } from '@consts';
import { getAllHighlights } from '@lib/highlights';
import HighlightSchema from '@components/HighlightSchema.astro';
import { enrichHighlightsWithImages } from '../data/highlights';
import HighlightsList from '@components/HighlightsList.astro';

const highlights = await getAllHighlights();
const enrichedHighlights = await enrichHighlightsWithImages(highlights);
---

<Layout title={HIGHLIGHTS.TITLE} description={HIGHLIGHTS.DESCRIPTION}>
  <HighlightSchema items={enrichedHighlights} slot="head" />
  <Container>
    <div class="animate">
      <div class="mb-8">
        <BackToPrevious href="/" />
      </div>
      <h1 class="mb-6 text-3xl font-semibold text-black dark:text-white">{HIGHLIGHTS.TITLE}</h1>
      <div class="not-prose">
        <HighlightsList items={enrichedHighlights} showHeader={false} />
      </div>
    </div>
  </Container>
</Layout>
