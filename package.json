{
  "name": "web",
  "type": "module",
  "version": "0.1.0",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "npm run fetch && npm run mvdata && npm test && astro build && npm run test:artifacts",
    "preview": "astro preview",
    "fetch": "node tests/run-all.mjs",
    "check": "astro check",
    "check:links": "lychee ./dist/client/**/*.html --config lychee.toml",
    "check:links:full": "lychee ./dist/client/**/*.html --config lychee.toml --verbose",
    "format": "prettier --write .",
    "test": "vitest run --exclude tests/build_artifacts_tests",
    "test:cov": "vitest run --coverage --exclude tests/build_artifacts_tests",
    "test:artifacts": "vitest run tests/build_artifacts_tests",
    "test:local": "npm test && npx playwright test --config=playwright.config.local.mjs",
    "test:build": "npx playwright test --config=playwright.config.build.mjs",
    "test:update": "npx playwright test --config=playwright.config.local.mjs --update-snapshots",
    "clean": "rm -rf dist .astro src/data/*.json",
    "mvdata": "mkdir -p public/data; cp src/data/*.json public/data",
    "knip": "knip"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/cloudflare": "^14.4.9",
    "@astrojs/mdx": "^8.1.6",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.6",
    "@fontsource/inter": "^5.2.8",
    "@tailwindcss/vite": "^4.3.5",
    "astro": "^7.4.13",
    "astro-indexnow": "^2.3.10",
    "astro-pagefind": "^2.0.1",
    "astro-seo": "^1.2.0",
    "astro-seo-schema": "^7.0.2",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.3.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@tailwindcss/typography": "^0.5.18",
    "@vitest/coverage-istanbul": "^5.1.2",
    "gray-matter": "^4.0.3",
    "knip": "^5.44.0",
    "path-browserify": "^1.0.1",
    "prettier": "^3.7.4",
    "prettier-plugin-astro": "^1.1.2",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "typescript": "^5.7.3",
    "vitest": "^5.1.2"
  }
}
